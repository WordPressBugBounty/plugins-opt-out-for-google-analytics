{
    "name": "gaoo/optout",
    "d4Shortcode": "gaoo_optout",
    "title": "Opt-Out for Google Analytics",
    "titles": "Opt-Out for Google Analytics",
    "description": "Displays the link, which allows the visitor to disallow or allow the tracking by Google Analytics.",
    "keywords": [
        "opt out",
        "optout",
        "google analytics",
        "gdpr",
        "dsgvo",
        "privacy"
    ],
    "moduleIcon": "gaoo/lock",
    "moduleClassName": "gaoo_optout",
    "moduleOrderClassName": "gaoo_optout",
    "category": "module",
    "childrenName": [],
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Opt-Out for Google Analytics"
                        }
                    }
                }
            },
            "settings": {
                "meta": {
                    "adminLabel": {}
                },
                "advanced": {
                    "html": {},
                    "text": {},
                    "htmlAttributes": {}
                },
                "decoration": {
                    "background": {},
                    "sizing": {},
                    "spacing": {},
                    "border": {},
                    "boxShadow": {},
                    "filters": {},
                    "transform": {},
                    "animation": {},
                    "overflow": {},
                    "disabledOn": {},
                    "transition": {},
                    "position": {},
                    "zIndex": {},
                    "scroll": {},
                    "sticky": {}
                }
            }
        },
        "link": {
            "type": "object",
            "selector": "{{selector}} .gaoo-link",
            "settings": {
                "decoration": {
                    "font": {
                        "priority": 10,
                        "component": {
                            "props": {
                                "groupLabel": "Link Text",
                                "fieldLabel": "Link"
                            }
                        }
                    }
                }
            }
        },
        "linkDeactivate": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "contentLinkTexts",
                        "priority": 10,
                        "render": true,
                        "attrName": "linkDeactivate.innerContent",
                        "label": "Text of link for deactivate",
                        "description": "Leave empty to use the text from the settings.",
                        "features": {
                            "sticky": false,
                            "responsive": false,
                            "hover": false,
                            "dynamicContent": {
                                "type": "text"
                            }
                        },
                        "component": {
                            "name": "divi/text",
                            "type": "field"
                        }
                    }
                }
            }
        },
        "linkActivate": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "contentLinkTexts",
                        "priority": 20,
                        "render": true,
                        "attrName": "linkActivate.innerContent",
                        "label": "Text of link for activate",
                        "description": "Leave empty to use the text from the settings.",
                        "features": {
                            "sticky": false,
                            "responsive": false,
                            "hover": false,
                            "dynamicContent": {
                                "type": "text"
                            }
                        },
                        "component": {
                            "name": "divi/text",
                            "type": "field"
                        }
                    }
                }
            }
        },
        "popupDeactivate": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "contentPopupTexts",
                        "priority": 10,
                        "render": true,
                        "attrName": "popupDeactivate.innerContent",
                        "label": "Popup Text for deactivate",
                        "description": "Leave empty to use the text from the settings.",
                        "features": {
                            "sticky": false,
                            "responsive": false,
                            "hover": false,
                            "dynamicContent": {
                                "type": "text"
                            }
                        },
                        "component": {
                            "name": "divi/textarea",
                            "type": "field"
                        }
                    }
                }
            }
        },
        "popupActivate": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "contentPopupTexts",
                        "priority": 20,
                        "render": true,
                        "attrName": "popupActivate.innerContent",
                        "label": "Popup Text for activate",
                        "description": "Leave empty to use the text from the settings.",
                        "features": {
                            "sticky": false,
                            "responsive": false,
                            "hover": false,
                            "dynamicContent": {
                                "type": "text"
                            }
                        },
                        "component": {
                            "name": "divi/textarea",
                            "type": "field"
                        }
                    }
                }
            }
        },
        "popupType": {
            "type": "object",
            "default": {
                "innerContent": {
                    "desktop": {
                        "value": "default"
                    }
                }
            },
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "contentBehavior",
                        "priority": 10,
                        "render": true,
                        "attrName": "popupType.innerContent",
                        "label": "Show the popup text as",
                        "features": {
                            "sticky": false,
                            "responsive": false,
                            "hover": false
                        },
                        "component": {
                            "name": "divi/select",
                            "type": "field",
                            "props": {
                                "options": {
                                    "default": {
                                        "label": "Like the settings"
                                    },
                                    "alert": {
                                        "label": "Browser popup"
                                    },
                                    "notice": {
                                        "label": "Text below the link"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "forceReload": {
            "type": "object",
            "default": {
                "innerContent": {
                    "desktop": {
                        "value": "default"
                    }
                }
            },
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "contentBehavior",
                        "priority": 20,
                        "render": true,
                        "attrName": "forceReload.innerContent",
                        "label": "Reload the page after the click",
                        "features": {
                            "sticky": false,
                            "responsive": false,
                            "hover": false
                        },
                        "component": {
                            "name": "divi/select",
                            "type": "field",
                            "props": {
                                "options": {
                                    "default": {
                                        "label": "Like the settings"
                                    },
                                    "yes": {
                                        "label": "Yes"
                                    },
                                    "no": {
                                        "label": "No"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "notice": {
            "type": "object",
            "selector": "{{selector}} .gaoo-notice",
            "settings": {
                "decoration": {
                    "font": {
                        "priority": 20,
                        "component": {
                            "props": {
                                "groupLabel": "Notice Text",
                                "fieldLabel": "Notice"
                            }
                        }
                    },
                    "background": {
                        "priority": 21,
                        "component": {
                            "props": {
                                "groupLabel": "Notice Background"
                            }
                        }
                    },
                    "spacing": {
                        "priority": 22,
                        "component": {
                            "props": {
                                "groupLabel": "Notice Spacing"
                            }
                        }
                    }
                }
            }
        }
    },
    "customCssFields": {
        "link": {
            "subName": "link",
            "selectorSuffix": " .gaoo-link"
        },
        "notice": {
            "subName": "notice",
            "selectorSuffix": " .gaoo-notice"
        }
    },
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "contentLinkTexts": {
                "panel": "content",
                "priority": 10,
                "groupName": "linkTexts",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Link texts"
                    }
                }
            },
            "contentPopupTexts": {
                "panel": "content",
                "priority": 20,
                "groupName": "popupTexts",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Popup texts"
                    }
                }
            },
            "contentBehavior": {
                "panel": "content",
                "priority": 30,
                "groupName": "behavior",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Behavior"
                    }
                }
            }
        }
    }
}
